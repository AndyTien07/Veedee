%% 1. Configuration
%%THIS SCRIPT HAS NO TIRE LOADS
DATA_PATH = fullfile("T36 Comp Autox real.csv");
opts = detectImportOptions(DATA_PATH);
data = readtable(DATA_PATH, opts);

Front_conversion_factor=1.24482467/(13.25*60);
Rear_conversion_factor=1.24482467/(13.25*60);

FR_v=-data.FRrpm*Front_conversion_factor;
FL_v=data.FLrpm*Front_conversion_factor;
RR_v=-data.RRrpm*Rear_conversion_factor;
RL_v=data.RLrpm*Rear_conversion_factor;
average_vel=FR_v+FL_v+RR_v+RL_v;
average_vel=average_vel/4;

time=data.Time;
steer=data.Steer;
ay=data.Ay;
yawr=-data.YawR;
L=1.535;


delta_ack = atan((L* deg2rad(yawr)) ./ average_vel);   % radians
steer_error = deg2rad(steer) - delta_ack;

figure()
scatter(steer,yawr,5,average_vel)

figure()
scatter(average_vel,yawr,5,steer)

figure()
hold on
plot(time, yawr);
plot(time,steer);
plot(time,average_vel);

figure()
plot(average_vel,steer_error)